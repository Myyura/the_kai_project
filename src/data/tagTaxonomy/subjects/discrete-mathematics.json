        "Discrete-Mathematics.Discrete-Mathematics"
      ]
    },
    "Discrete-Mathematics.Graph-Theory": {
      "subject": "Discrete-Mathematics",
      "labelZh": "图论",
      "labelJa": "グラフ理論",
      "labelEn": "Graph Theory",
      "descriptionZh": "图、树、割、匹配、连通性、平面图、同构、欧拉回路与基础性质。",
      "descriptionJa": "グラフ、木、カット、マッチング、連結性、平面グラフ、同型、オイラー回路、基礎性質。",
      "descriptionEn": "Graphs, trees, cuts, matchings, connectivity, planar graphs, isomorphism, Euler circuits, and foundational properties."
    },
    "Discrete-Mathematics.Graph-Algorithms": {
