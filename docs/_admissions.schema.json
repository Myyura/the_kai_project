{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Kai Project admission statistics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "sources",
    "series"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": [
        "graduate_school_total",
        "program",
        "course",
        "aggregate"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/series"
      }
    }
  },
  "$defs": {
    "notes": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "type",
        "confidence",
        "checkedAt"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "type": {
          "enum": [
            "official",
            "community"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "evidenceLocator": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "nullableCount": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admissionYear",
        "sourceIds"
      ],
      "properties": {
        "admissionYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "capacity": {
          "$ref": "#/$defs/nullableCount"
        },
        "applicants": {
          "$ref": "#/$defs/nullableCount"
        },
        "examinees": {
          "$ref": "#/$defs/nullableCount"
        },
        "admitted": {
          "$ref": "#/$defs/nullableCount"
        },
        "enrolled": {
          "$ref": "#/$defs/nullableCount"
        },
        "reportedRatio": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "sourceType",
        "confidence",
        "degree",
        "period",
        "selection",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "enum": [
            "official",
            "community"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "degree": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "string",
          "minLength": 1
        },
        "comparisonKey": {
          "type": "string",
          "minLength": 1,
          "description": "Optional explicit equivalence key used to let official ratios supersede community ratios for the same year and scope."
        },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    }
  }
}
